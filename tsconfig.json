{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    // "baseUrl": ".",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "src/**/*.ts", "src/**/*.tsx",
    "components/**/*.ts", "components/**/*.tsx",
    "features/**/*.ts", "features/**/*.tsx",
    "hooks/**/*.ts", "hooks/**/*.tsx",
    "lib/**/*.ts", "lib/**/*.tsx",
    "server/**/*.ts", "trigger.config.ts", "liveblocks.config.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "dist", "browser-automation-app"]
}
